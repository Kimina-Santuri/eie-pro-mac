<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>EIE Pro driver @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <volume-check>
        <allowed-os-versions><os-version min="14.0"/></allowed-os-versions>
    </volume-check>
    <pkg-ref id="co.ke.kimina.eie-pro"/>
    <choices-outline><line choice="default"><line choice="co.ke.kimina.eie-pro"/></line></choices-outline>
    <choice id="default"/>
    <choice id="co.ke.kimina.eie-pro" visible="false"><pkg-ref id="co.ke.kimina.eie-pro"/></choice>
    <pkg-ref id="co.ke.kimina.eie-pro" version="@VERSION@" onConclusion="none">EIEPro-component.pkg</pkg-ref>
</installer-gui-script>
